do_domain: nop
set_lbm_parameters: nop
set_obstacles: nop
set_distributions: nop

set_default_distribution:
  condition: do_set_distributions
  body:
    - set_distribution:
       do_update: false

init_obstacles_if_needed:
  condition: do_set_distributions
  body:
    - init_obstacles

setup_obstacles:
  - init_obstacles_if_needed
  - set_obstacles

default_grid: define_grid_3dq19

grid_flavor: default_grid

initialize:
  - global
  - do_domain
  - set_lbm_parameters
  - print_domain
  - build_traversal
  - grid_flavor
  - init_obst
  - set_default_distribution
  - set_distributions
  - setup_obstacles
  - update_obstacles
  - macro_variables
  - simulation_state
  - write_paraview_first_timestep
  - log
  - analysis
  - next_time_step


global:
   timestep: 0
   physical_time: 0.
   compute_loop_continue: true
   simulation_paraview_freq: -1
   simulation_dump_freq: -1
   simulation_analysis_freq: -1
   simulation_print_log_freq: 1
   simulation_end_iteration: 10
   display_paraview_first_timestep: false

