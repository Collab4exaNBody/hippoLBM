compute_loop_stop:
  profiling: false
  rebind: { end_at: simulation_end_iteration , result: compute_loop_continue }
  body:
    - sim_continue

pre_bounce_back_if_needed:
  condition: has_bounce_back
  body:
    - pre_bounce_back

pre_stream_bcs:
  - pre_bounce_back_if_needed
  - wall_bounce_back

post_bounce_back_if_needed:
  condition: has_bounce_back
  body:
    - post_bounce_back

post_stream_bcs:
  - post_bounce_back_if_needed

boundary_conditions: nop
start_iteration: nop

end_iteration:
  body:
    - trigger_dump_paraview
    - trigger_dump_checkpoint
    - trigger_print_log
    - trigger_analysis
    - dump_paraview_if_triggered
    - dump_checkpoint_if_triggered
    - print_log_if_triggered
    - print_analysis_if_triggered

compute_macro_variables: macro_variables # default model
collision: bgk # default model

compute_loop:
  loop: true
  name: loop
  condition: compute_loop_continue
  body:
  - start_iteration
  - compute_macro_variables
  - collision
  - pre_stream_bcs
  - streaming:
     asynchrone: false
  - post_stream_bcs
  - boundary_conditions
  - end_iteration
  - next_time_step  
  - compute_loop_stop
