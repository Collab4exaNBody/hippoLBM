do_domain:
  - domain:
     bounds: [[0,0,0],[0.1,0.1,0.1]]
     cell_dims: [ 30, 30, 30 ]
     periodic: [true, true, false]

set_lbm_parameters:
  - lbm_parameters:
     nuth: 1e-2

compute_macro_variables:
  - macro_variables_couette:
     U_inf: [-0.001,0,0]
     U_sup: [0.001,0,0]

collision:
  - bgk_couette:
     U_inf: [-0.001,0,0]
     U_sup: [0.001,0,0]

boundary_conditions:
  - neumann:
     U: [-0.001,0,0]
     regions: [plan_xy_l]
  - neumann:
     U: [0.001,0,0]
     regions: [plan_xy_0]

checker_op:
  - check_macro_quantities:
     density: 27900  # 30x30x31
     tol: 1e-8
     vmin: 0.00
     vmax: 1.2e-03

global:
   simulation_paraview_freq: -1
   simulation_end_iteration: 20
