do_domain:
  - domain:
     bounds: [[0,0,0],[0.1,0.1,0.1]]
     cell_dims: [ 30, 30, 30 ]
     periodic: [false, false, false]
     bounce_back_planes: [plan_yz_0, plan_yz_l, plan_xz_0, plan_xz_l, plan_xy_0, plan_xy_l]

set_lbm_parameters:
  - lbm_parameters:
     Fext: [0,0,0]
     nuth: 1e-4

+pre_stream_bcs:
  - cavity_z_l:
     U: [0.0, 0.1, 0]

checker_op:
  - check_macro_quantities:
     density: 29791
     tol: 0.1
     vmin: 1.00e-06
     vmax: 1.00e-01

global:
   simulation_paraview_freq: -1
   simulation_end_iteration: 100
