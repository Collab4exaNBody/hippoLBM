includes:
  - perf_couette_512x512x512.msp

# fuse_pull_bgk replaces macro_variables + collision + streaming (pull/gather, 2 kernels: collide
# then gather) with a single fused OperatorNode; only boundary_conditions still runs separately.
compute_loop:
  loop: true
  name: loop
  condition: compute_loop_continue
  body:
  - start_iteration
  - fuse_pull_bgk
  - boundary_conditions
  - end_iteration
  - next_time_step
  - compute_loop_stop
