do_domain:
  - domain:
     bounds:    [ [ 0 , 0 , 0 ] , [ 0.1 , 0.1 , 0.1 ] ]
     cell_dims: [ 100, 100, 100 ]
     periodic:  [ false, false, false ]
     bounce_back_planes: [plan_yz_0, plan_yz_l, plan_xz_0, plan_xz_l, plan_xy_0, plan_xy_l]

set_lbm_parameters:
  - lbm_parameters:
     Fext: [0,0,0]
     nuth: 1e-4

+pre_stream_bcs:
  - cavity_z_l:
     U: [0.1, 0.0, 0]

set_obstacles:
  - register_solid_wall:
     id: 0
     bounds: [ [ 0.048 , 0 , 0 ] , [ 0.052 , 0.1 , 0.08 ] ]

global:
   simulation_paraview_freq: 25
   simulation_end_iteration: 1000
   simulation_print_log_freq: 10
   output_directory: "CavityWithWallDir"   
